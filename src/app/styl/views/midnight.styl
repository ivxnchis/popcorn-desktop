// Midnight theme layout: a streaming-app look for macOS.
// Imported after views/app, so these rules refine the shared ones.

glass()
    background-color $Glass
    backdrop-filter blur(28px) saturate(180%)

// ---------- Base

#main-window
    font-size 13px
    letter-spacing 0.01em
    box-shadow none

::selection
    background rgba($Accent, 0.35)

.tooltip-inner
    background-color rgba(30, 32, 38, 0.96)
    border-radius 8px
    padding 5px 10px
    font-size 12px

// ---------- Top bar: window buttons, tabs, filters and search in one glass bar

#header
    width 92px
    height $FilterBarHeight
    padding 0
    background transparent
    z-index 12

    h1,
    .events
        display none

    nav.darwin
        left 20px
        top 50%
        margin-top -6px

.filter-bar
    top 0
    height $FilterBarHeight
    padding-left 84px
    box-sizing border-box
    glass()
    border-bottom 1px solid $Hairline
    opacity 1
    -webkit-app-region drag

    ul,
    li,
    a,
    i,
    input,
    form
        -webkit-app-region no-drag

    .nav
        font-size 13px

    // tabs
    .source
        margin 0
        padding 0 12px
        height $FilterBarHeight
        line-height $FilterBarHeight
        font-size 15px
        font-weight 600
        color rgba(255, 255, 255, 0.6)
        border none
        position relative
        transition color 0.2s

        &:hover
            color #fff

        &.active
            color #fff
            border none

            &::after
                content ''
                position absolute
                left 12px
                right 12px
                bottom 9px
                height 3px
                border-radius 3px
                background $Accent

    // genre / sort filters as quiet pills
    .nav.filters
        margin-left 14px
        height $FilterBarHeight
        display flex
        align-items center

    .filter
        padding 0
        margin 0 0 0 8px

        & > a
            display flex
            align-items center
            gap 6px
            height 30px
            padding 0 12px !important
            border-radius 999px
            background-color rgba(255, 255, 255, 0.08) !important
            color rgba(255, 255, 255, 0.7)
            font-size 13px
            transition background-color 0.2s, color 0.2s

            &:hover
                background-color rgba(255, 255, 255, 0.14) !important
                color #fff

        .value
            color #fff
            font-weight 600
            padding-left 0

        .caret
            opacity 0.6

        .dropdown-menu
            margin-top 8px
            max-height 60vh

    // search and icons
    .nav.right
        height $FilterBarHeight
        display flex
        align-items center
        margin-right 14px

        & > li
            display flex
            align-items center

    i
        margin 0 2px
        padding 0
        width 32px
        height 32px
        line-height 32px
        text-align center
        border-radius 50%
        font-size 16px
        transition background-color 0.2s, color 0.2s

        &:hover
            background-color rgba(255, 255, 255, 0.1)

    .search
        margin-right 6px

        form
            &:before
                top 50%
                left 11px
                margin-top -8px
                font-size 13px
                color rgba(255, 255, 255, 0.6)

            input
                height 32px
                margin 0
                padding 0 12px 0 32px
                width 32px
                box-sizing border-box
                border-radius 999px
                background-color rgba(255, 255, 255, 0.08)
                color #fff
                font-size 13px

            &.edited input,
            input:focus,
            input.expanded
                width 220px
                padding-left 32px
                background-color rgba(255, 255, 255, 0.12)
                box-shadow 0 0 0 1px rgba(255, 255, 255, 0.12)

            &.edited .clear
                top 50%
                margin-top -12px

// dropdown menus float as glass panels
.dropdown-menu
    glass()
    background-color rgba(29, 32, 39, 0.9)
    border 1px solid $GlassBorder
    border-radius 12px !important
    box-shadow 0 18px 48px rgba(0, 0, 0, 0.5)
    padding 6px
    opacity 1

    & > li > a
        border-radius 7px
        padding 6px 12px
        color $DropDownText

        &:hover,
        &:focus
            background-color rgba(255, 255, 255, 0.08)
            border-left none
            color #fff

// ---------- Poster grid

.list
    .items
        padding 84px 28px 40px
        width 100%
        box-sizing border-box
        display grid
        grid-template-columns repeat(auto-fill, minmax(var(--poster-width, 150px), 1fr))
        column-gap 22px
        row-gap 30px
        justify-content stretch

    &::-webkit-scrollbar-track
        margin-top $FilterBarHeight

// the poster size setting sets fixed sizes; here it only sets the column width
.list .items .item.item
    margin 0
    width auto
    float none
    font-size 13px

    .cover
        width 100%
        height auto
        aspect-ratio 2 / 3
        background-size cover
        border-radius $PosterRadius
        box-shadow $PosterShadow
        overflow hidden
        position relative
        transition transform 0.25s ease, box-shadow 0.25s ease

        .cover-imgs,
        .cover-overlay
            border-radius $PosterRadius

        .cover-overlay.cover-info-overlay
            padding 0
            position absolute
            inset 0
            background linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0) 55%)

            .actions-favorites,
            .actions-watched
                position absolute
                top 10px
                margin 0
                width 30px
                height 30px
                line-height 30px
                text-align center
                border-radius 50%
                background rgba(20, 22, 27, 0.6)
                backdrop-filter blur(12px)
                font-size 13px
                opacity 0.9

            .actions-favorites
                right 10px

            .actions-watched
                left 10px

            .rating
                background none
                padding 10px 12px

    &:hover .cover
        transform translateY(-4px) scale(1.03)
        box-shadow 0 0 0 2px $PosterHoverBorder, 0 16px 36px rgba(0, 0, 0, 0.6)

    .title
        margin-top 10px
        color $Text1
        font-size 14px
        font-weight 600
        line-height 1.3
        white-space nowrap
        overflow hidden
        text-overflow ellipsis

    .title2,
    .year,
    .seasons
        color $Text3
        font-size 12px
        line-height 1.4

    .year
        display inline-block
        margin-right 6px

    .seasons
        display inline-block

// ---------- Movie detail: full-bleed backdrop, text anchored bottom-left

.close-icon
    width 36px
    height 36px
    line-height 36px
    text-align center
    border-radius 50%
    font-size 16px
    color #fff
    glass()
    background-color rgba(22, 24, 30, 0.55)
    border 1px solid $GlassBorder
    transition background-color 0.2s

    &:hover
        background-color rgba(60, 64, 72, 0.75)

.movie-detail,
.shows-container-contain
    .close-icon
        top 72px
        right 24px

.movie-detail
    padding-top 0
    background-color $BgColor1

    .backdrop
        margin-top 0
        height 100%
        -webkit-filter none
        filter none

    .backdrop-overlay
        opacity 1 !important
        background-color transparent
        background linear-gradient(90deg, rgba(11, 12, 15, 0.97) 0%, rgba(11, 12, 15, 0.88) 30%, rgba(11, 12, 15, 0.4) 62%, rgba(11, 12, 15, 0.1) 100%), linear-gradient(0deg, $BgColor1 0%, rgba(11, 12, 15, 0) 42%)

    .poster-box
        display none

    .content-box
        position relative
        width 100%
        height 100vh
        margin 0
        padding 96px 56px 44px
        box-sizing border-box
        justify-content flex-end

        .meta-container
            flex none
            height auto
            max-width 760px
            overflow visible
            margin 0
            padding 0

            .title
                top 0
                font-size 48px
                font-weight 800
                line-height 1.05
                letter-spacing -0.02em
                text-shadow 0 2px 24px rgba(0, 0, 0, 0.4)

            .metadatas
                top 0
                margin-top 16px
                height auto
                align-items center
                row-gap 6px

                .metaitem,
                .year,
                .certification
                    font-size 14px
                    font-weight 500
                    color rgba(255, 255, 255, 0.78)

                .metaitem::before
                    width 3px
                    height 3px
                    margin 8px 10px 0
                    background-color rgba(255, 255, 255, 0.5)

                .certification
                    padding 1px 6px
                    border 1px solid rgba(255, 255, 255, 0.45)
                    border-radius 4px
                    font-size 12px

            .overview
                top 0
                margin-top 18px
                max-height 7.8em
                max-width 640px
                padding-right 0
                font-size 15px
                line-height 1.55
                font-weight 400
                text-align left
                color rgba(255, 255, 255, 0.82)

            #torrent-list
                top 0
                margin 14px 0 0

        .play-control
            margin 26px 0 0
            height auto
            justify-content flex-start
            gap 24px
            align-items flex-end

            .flex-left
                min-width 0
                margin 0

            .toggles-container
                padding-bottom 14px

            .favourites-toggle,
            .watched-toggle
                font-size 13px
                color rgba(255, 255, 255, 0.75)

                &:hover
                    color #fff

            .row
                display flex
                align-items center
                gap 12px

            .play-selector,
            .quality-selector
                float none

            .button
                height 44px
                line-height 44px
                margin 0
                padding 0 22px
                font-size 15px
                font-weight 600
                glass()
                background-color rgba(255, 255, 255, 0.14)

                &:hover
                    background-color rgba(255, 255, 255, 0.24)

            // the main action is a solid white pill
            #player-chooser .button
                background-color #fff
                color #0b0c0f
                padding 0 14px 0 22px
                backdrop-filter none

                &:hover
                    background-color rgba(255, 255, 255, 0.88)

                .startStreaming
                    margin 0 4px 0 0
                    padding-left 22px
                    position relative

                    &:before
                        content '\f04b'
                        font-family 'Font Awesome 6 Free'
                        font-weight 900
                        font-size 13px
                        position absolute
                        left 0

                .playerchoice
                    border-left 1px solid rgba(0, 0, 0, 0.15)

                    img
                        filter invert(1)

            .sdow-quality
                .active
                    background rgba(255, 255, 255, 0.18)

// ---------- Show detail: hero header, then seasons, episodes and overview

.show-detail-container
    padding-top 0

    .show-header
        position relative
        height 44vh
        min-height 0
        display flex
        align-items flex-end
        padding 0 56px 26px
        box-sizing border-box

        .sh-backdrop
            position absolute
            inset 0
            overflow hidden

            .shb-img
                margin-top 0
                height 100%
                -webkit-filter none
                filter none

            &::after
                content ''
                position absolute
                inset 0
                background linear-gradient(90deg, rgba(11, 12, 15, 0.95) 0%, rgba(11, 12, 15, 0.78) 34%, rgba(11, 12, 15, 0.25) 70%, rgba(11, 12, 15, 0.05) 100%), linear-gradient(0deg, $BgColor1 0%, rgba(11, 12, 15, 0) 60%)

        .sh-poster
            display none

        .sh-metadata
            float none
            flex 1
            width auto
            height auto
            max-width 820px
            padding 0

            .shm-title
                font-size 44px
                font-weight 800
                line-height 1.05
                letter-spacing -0.02em
                margin 0 0 12px
                text-shadow 0 2px 24px rgba(0, 0, 0, 0.4)

            .shm-infos div
                font-size 14px
                font-weight 500
                color rgba(255, 255, 255, 0.78)

            .shm-synopsis
                font-size 14px
                line-height 1.5
                color rgba(255, 255, 255, 0.8)

        .sh-actions
            position relative
            float none

    .show-details
        height 56vh
        padding 6px 40px 24px 44px
        gap 28px
        box-sizing border-box

        &,
        &.transpOff,
        &.transpVLow,
        &.transpLow,
        &.transpHigh,
        &.transpVHigh
            background transparent

        .sd-seasons,
        .sd-episodes
            .sds-title,
            .sde-title
                font-size 18px
                font-weight 700
                margin-bottom 10px

        .sd-seasons ul,
        .sd-episodes ul
            li
                margin 2px 0
                border-radius 8px
                width calc(100% - 10px)

            li:nth-child(odd)
                background-color transparent

            li:hover
                background rgba(255, 255, 255, 0.06)

            li.active
                background-color rgba(255, 255, 255, 0.1)
                box-shadow inset 3px 0 0 $Accent

                &:after
                    display none

            a
                font-size 14px

                div
                    border-left none
                    padding-left 12px

        .sd-overview
            &,
            &.transpOff
                background $Surface
            border-radius 16px
            padding 18px 24px
            margin-bottom 8px

            .sdo-infos .sdoi-title
                font-size 20px
                font-weight 700
