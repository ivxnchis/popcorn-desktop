// POPCORN-THEME: MIDNIGHT
// Near-black streaming look with a green accent and frosted-glass bars,
// made for macOS. Layout changes live in views/midnight.styl.

//Fonts
    $Font = system-ui
    $MainFont = system-ui
    $MainFontBold = system-ui
    $AlternateFont = sans-serif
    $ButtonFont = system-ui

//Palette
    $Accent = #1ce783
    $AccentText = #04150c
    $Glass = rgba(22, 24, 30, 0.72)
    $GlassBorder = rgba(255, 255, 255, 0.08)
    $Hairline = rgba(255, 255, 255, 0.06)
    $Surface = #15171c
    $SurfaceRaised = #1d2027

//Layout: one merged top bar instead of a title bar plus a filter bar
    $TitleHeight = 0px
    $FilterBarHeight = 56px
    $HeaderHeight = 72px

//Main app
    $BgColor1 = #0b0c0f
    $BgColor2 = #15171c
    $Text1 = #fff
    $Text2 = #c5c9cf
    $Text3 = #9096a0
    $Text4 = #5c616a
    $TextError = #8a8f98
    $CloseButton = #d6d9de
    $CloseButtonHover = #fff
    $SpinnerColor1 = #1ce783
    $SpinnerColor2 = rgba(28, 231, 131, 0.9)
    $ScrollBarBg = transparent
    $ScrollBarThumb = rgba(255, 255, 255, 0.2)
    $ScrollBarThumbHover = rgba(255, 255, 255, 0.35)

//Top Bar
    $TitleBarBg = transparent
    $TitleBarText = #fff
    $TbarIconFilter = none
    $FullScreenButton = #9096a0
    $FullScreenButtonHover = #fff
    $FilterBarBg = rgba(11, 12, 15, 0.72)
    $FilterBarText = #b3b8c0
    $FilterBarTextHover = #fff
    $FilterBarActive = #1ce783
    $SearchBoxBg = rgba(255, 255, 255, 0.1)
    $DropDownBg = #1d2027
    $DropDownBgHover = rgba(255, 255, 255, 0.08)
    $DropDownTextHover = #fff
    $DropDownText = #c5c9cf
    $DropDownOpacity = 0.98
    $FilterBarIcon = #b3b8c0
    $FilterBarIconHover = #fff
    $FilterBarIcon-PosterWidth = #6a6f78
    $TopBarShadow = none

//$ButtonBg
    $ButtonBg = rgba(255, 255, 255, 0.12)
    $ButtonBgHover = rgba(255, 255, 255, 0.2)
    $ButtonBgActive = #1ce783
    $ButtonBgDisabled = rgba(255, 255, 255, 0.06)
    $ButtonBgOk = #1ce783
    $ButtonBgWarning = #ff5f57
    $ButtonText = #fff
    $ButtonTextHover = #fff
    $ButtonImgInvert = 0
    $ButtonRadius = 999px

//Checkbox
    $CheckboxBg = #3a3e46
    $CheckboxCheck = #1ce783

//Posters
    $PosterRadius = 10px
    $PosterHoverBorder = rgba(255, 255, 255, 0.9)
    $PosterHoverOverlay = rgba(11, 12, 15, 0.5)
    $PosterHoverOverlayOpq = rgba(11, 12, 15, 1)
    $PosterShadow = 0 6px 18px rgba(0, 0, 0, 0.45)

//TV Series
    $ShowBgColor1 = #0b0c0f
    $ShowBgColor2 = #15171c
    $EpisodeDetailsBg = #15171c
    $ShowText1 = #fff
    $ShowText2 = #9096a0
    $ShowOddHighlight = #fff
    $ShowOddHighlightOp = 0.03
    $SaisonListText = #fff
    $EpisodeListText = #b3b8c0
    $EpisodeSelectorBg = rgba(28, 231, 131, 0.16)
    $EpisodeSelectorHover = rgba(255, 255, 255, 0.06)
    $EpisodeSelectorHoverTran = rgba(255, 255, 255, 0.06)
    $EpisodeSelectorText = #fff
    $ShowWatchedIcon_false = rgba(#fff, 0.2)
    $ShowWatchedIcon_hover = rgba(#fff, 0.45)
    $ShowWatchedIcon_true = #1ce783
    $QualitySelectorBg = rgba(255, 255, 255, 0.14)
    $QualitySelectorText = #fff

//File selector
    $FileSelectorText = #eee
    $FileSelectorBg = rgba(255, 255, 255, 0.05)
    $FileSelectorShadow = rgba(0, 0, 0, 0.67)

//Settings
    $SettingsCategoriesText = #1ce783
    $SettingsSeparator = rgba(255, 255, 255, 0.08)
    $InputBoxBg = rgba(255, 255, 255, 0.08)
    $InputBoxText = #e3e6ea
    $SettingsText1 = #e3e6ea
    $SettingsText2 = #9096a0
    $SettingsButtonText = #fff
    $SettingsButtonTextHover = #fff

// Notifications
    $NotificationText = #fff
    $NotificationInfo = #3b82f6
    $NotificationSuccess = #1ce783
    $NotificationWarning = #f5b83d
    $NotificationOrange = #f07f53
    $NotificationError = #ff5f57
    $NotificationBorderColor = transparent
    $NotificationBtn = rgba(255, 255, 255, 0.12)
    $NotificationBtnText = #fff
    $NotifAlertBg = #000
    $NotifAlertText = #fff

//Misc
    $PngLogo = brightness(1.0)
    $PngLogo_BgColo1 = brightness(1.0)
    $WarningColor = #f5b83d
    $FavoriteColor = #ff5f57

//Player
    $PlayerColor = #1ce783

// POPCORN-THEME: MIDNIGHT - END

@import 'views/app'
@import 'views/midnight'
